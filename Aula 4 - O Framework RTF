# Caso 1: Lista válida
print(calcular_media([10, 20, 30]))  # Esperado: 20.0

# Caso 2: Lista vazia (deve gerar erro)
try:
    print(calcular_media([]))
except Exception as e:
    print(e)  # Esperado: ValueError

# Caso 3: Lista com elemento inválido
try:
    print(calcular_media([10, "a", 30]))
except Exception as e:
    print(e)  # Esperado: TypeError
